// AnyStudio — identity, sessions, authorization and onboarding.
//
// THE CENTRAL DECISION IN THIS FILE
// ---------------------------------
// One human is one `User` row, everywhere. The same email, phone, password and
// passkey work on app.anystudio.ai, org.anystudio.ai and admin.anystudio.ai —
// that is the "same details" requirement, and it is met by sharing the
// IDENTITY.
//
// Sessions are NOT shared. Every session is minted for exactly one surface and
// is worthless on the others. If an app session could be presented to the admin
// API, then one XSS on the customer app, or one unlocked laptop with an open
// tab, is a full admin compromise. Shared identity is a convenience; a shared
// session is a single point of total failure.
//
// Staff authority is a GRANT on the same user (`StaffGrant`), never a separate
// account. Revoking staff access is one row, and it does not touch the person's
// own workspace, their credits or their history.

generator client {
  provider = "prisma-client-js"
}

// EXTENSIONS ARE CREATED IN SQL, NOT DECLARED HERE
//
// `citext` and `pgcrypto` are created by the _init migration with plain
// CREATE EXTENSION statements, and `@db.Citext` below works because the type
// exists in the database — the native type does not need Prisma to manage the
// extension.
//
// They used to be declared with `extensions = [citext, pgcrypto]` under the
// `postgresqlExtensions` preview feature, and that is what broke CI: with the
// declaration present, `migrate diff --from-migrations` compares extension
// metadata after replaying the migrations and reports both as still needing to
// be added, every time. Phantom drift on a schema that is in fact correct —
// the migrations apply cleanly and the citext columns are created.
//
// Declaring them bought nothing (Prisma does not create extensions on
// `migrate deploy` from a declaration alone) and cost a permanently red drift
// check, which is worse than useless: a check that always fails is one nobody
// reads on the day it means something.

datasource db {
  provider = "postgresql"
  /// Every request the API serves goes through this one. On Render it is the
  /// database's direct connection string today, and becomes the pgbouncer
  /// pool string the moment more than one instance runs.
  url        = env("DATABASE_URL")
  /// Migrations only. They run DDL and take advisory locks, neither of which
  /// survives a transaction pooler, so `migrate deploy` uses this and nothing
  /// else does. Falls back to DATABASE_URL when unset, which is right both
  /// locally and on a Render database with no pool in front of it yet.
  directUrl  = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED // blocked by staff; can still sign in to read, cannot generate
  DELETED   // soft, so the ledger and audit trail stay intact
}

/// One person. Credentials live here and on Identity; authority does not.
/// Nothing in this model says what the user is allowed to do — that comes from
/// WorkspaceMember (customer authority) and StaffGrant (staff authority).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// citext: nobody should be locked out because they typed Ada@ instead of ada@
  email           String?    @unique @db.Citext
  emailVerifiedAt DateTime?
  /// E.164. The free tier is keyed to a verified phone, so this is also the
  /// abuse boundary, not just a contact detail.
  phone           String?    @unique
  phoneVerifiedAt DateTime?
  /// Whether that phone is reachable on WhatsApp. Functional, NOT consent to
  /// market — marketing consent is a Consent row and is asked separately.
  phoneIsWhatsApp Boolean    @default(false)
  name            String?
  /// Argon2id. Null for accounts that only ever used Google, WhatsApp or a
  /// passkey — absence of a password must never mean "any password works".
  passwordHash    String?
  status          UserStatus @default(ACTIVE)
  /// Bumped on password change, MFA removal and "sign out everywhere". Any
  /// session or refresh token minted before this instant is dead on arrival.
  credentialEpoch Int        @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  identities       Identity[]
  mfaFactors       MfaFactor[]
  recoveryCodes    RecoveryCode[]
  sessions         Session[]
  staffGrants      StaffGrant[]      @relation("StaffSubject")
  grantsIssued     StaffGrant[]      @relation("StaffGrantor")
  workspaceMembers WorkspaceMember[]
  onboarding       OnboardingState[]
  consents         Consent[]
  authEvents       AuthEvent[]
  generations      Generation[]

  @@index([status])
  @@map("users")
}

enum IdentityProvider {
  PASSWORD
  GOOGLE
  WHATSAPP // phone ownership proved by an OTP delivered over WhatsApp
  PASSKEY
}

/// A way of proving you are a given User. Several rows per user is the point:
/// it is what lets someone sign up on WhatsApp from a phone and later sign in
/// with Google on a laptop and land in the same account.
model Identity {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  provider    IdentityProvider
  /// Google `sub`, the E.164 number, or the WebAuthn credential id.
  providerUid String
  /// Public key for PASSKEY, nothing for the rest. Never a secret in cleartext.
  publicKey   String?
  /// WebAuthn replay protection: a counter that goes backwards means a clone.
  signCount   Int?             @default(0)
  label       String?
  lastUsedAt  DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("identities")
}

enum MfaType {
  TOTP
  WEBAUTHN
  SMS // last resort only; SIM swap makes this the weakest factor we offer
}

/// A second factor. Staff are required to hold at least one non-SMS factor —
/// enforced in application code, because "at least one of a filtered set" is
/// not a constraint the database can express.
model MfaFactor {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  type        MfaType
  /// TOTP seed, encrypted with the app key. Never the raw seed.
  secretEnc   String?
  credentialId String?
  label       String?
  /// Unconfirmed factors do not count. A half-finished TOTP setup must never
  /// be the thing standing between an attacker and the admin console.
  confirmedAt DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, confirmedAt])
  @@map("mfa_factors")
}

/// Single-use codes for a lost device. Hashed, because a leaked table of these
/// is a leaked table of second factors.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// ---------------------------------------------------------------------------
// SESSIONS — the isolation boundary
// ---------------------------------------------------------------------------

enum Surface {
  APP   // app.anystudio.ai      — a person's own workspaces
  ORG   // org.anystudio.ai      — organization members
  ADMIN // admin.anystudio.ai    — staff only, MFA always
}

/// One row per signed-in browser, per surface.
///
/// Opaque random tokens, hashed at rest — not JWTs. Revocation has to be
/// instant for staff, and a stateless token cannot be taken back. The cost is a
/// lookup per request, which is one indexed read.
model Session {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  /// The surface this session was minted FOR. An APP session presented to the
  /// admin API is rejected — not upgraded, not re-prompted. Rejected.
  surface   Surface
  /// SHA-256 of the session token. The plaintext exists only in the cookie.
  tokenHash String  @unique
  /// Refresh tokens rotate on every use and belong to a family. Presenting an
  /// already-rotated token means it was stolen, so the whole family dies.
  refreshHash   String? @unique
  refreshFamily String? @db.Uuid
  /// 0 = password only, 1 = plus a verified factor, 2 = a factor within the
  /// step-up window. Admin sessions are minted at 2 and decay to 1.
  mfaLevel      Int     @default(0)
  lastStepUpAt  DateTime?
  /// Snapshot of User.credentialEpoch at mint. A mismatch kills the session,
  /// which is how "sign out everywhere" works without walking every row.
  credentialEpoch Int   @default(0)

  ip        String?
  userAgent String?
  /// Coarse only — a city, never coordinates. Enough to say "a new sign-in from
  /// Lagos" without building a location history of our own customers.
  geoLabel  String?

  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  idleExpiresAt    DateTime
  absoluteExpiresAt DateTime
  revokedAt        DateTime?
  revokedReason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, surface, revokedAt])
  @@index([refreshFamily])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Short-lived challenges: email verification, password reset, OTP, invitations.
/// One table because they all behave the same way, and one place to get the
/// expiry, single-use and hashing rules right is better than four.
enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_OTP
  MFA_CHALLENGE
  STAFF_INVITE
  WORKSPACE_INVITE
  ORG_INVITE
}

model AuthToken {
  id         String       @id @default(uuid()) @db.Uuid
  purpose    TokenPurpose
  /// Hashed. A reset link in a log or a support screenshot must be inert.
  tokenHash  String       @unique
  userId     String?      @db.Uuid
  /// For invitations, where the recipient has no account yet.
  email      String?      @db.Citext
  phone      String?
  payload    Json?
  attempts   Int          @default(0)
  maxAttempts Int         @default(5)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())
  createdIp  String?

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// AUTHORITY
// ---------------------------------------------------------------------------

enum StaffRole {
  SUPPORT    // read, resend verification, read-only impersonation
  OPERATOR   // + re-run jobs, refund up to a cap, resolve abuse flags
  ADMIN      // + provider routing, plans and pricing, org limits
  SUPERADMIN // + manage staff grants
}

/// Staff authority attached to an ordinary user.
///
/// Deliberately NOT a column on User: a grant has an issuer, a reason, an
/// optional expiry and a revocation, and every one of those is something you
/// need in an incident review. A boolean tells you nothing afterwards.
model StaffGrant {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  role      StaffRole
  /// Nobody grants themselves staff access — enforced in the policy layer, and
  /// visible here because grantedById is never equal to userId in valid data.
  grantedById String  @db.Uuid
  reason      String
  /// Contractors and temporary escalations should expire on their own.
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  user      User @relation("StaffSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("StaffGrantor", fields: [grantedById], references: [id])

  @@index([userId, revokedAt])
  @@map("staff_grants")
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
  ORGANIZATION
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  BILLING
  AUDITOR
}

model Workspace {
  id        String        @id @default(uuid()) @db.Uuid
  type      WorkspaceType
  name      String
  /// Sets billing currency AND storage region. Changing it is a support action.
  region    String        @default("ng")
  currency  String        @default("NGN")
  /// The welcome questions: what they sell, how they sell it, the tone they
  /// want. Free-form JSON because it feeds prompts, not queries, and the
  /// questions will change more often than we want to migrate.
  profile   Json?
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  members    WorkspaceMember[]
  onboarding  OnboardingState[]
  wallet      Wallet?
  generations Generation[]
  media       MediaAsset[]
  brandKit    BrandKit?
  fingerprints CopyFingerprint[]

  @@index([type])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole
  invitedById String?       @db.Uuid
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// CONSENT — provable, because "we think they agreed" is not a defence
// ---------------------------------------------------------------------------

enum ConsentChannel {
  WHATSAPP_MARKETING
  EMAIL_MARKETING
  SMS_MARKETING
}

/// Meta requires an affirmative, unbundled opt-in before any marketing template
/// message, and requires the business to be able to produce it. So we store the
/// EXACT WORDING SHOWN, not a version pointer to text we will later edit.
model Consent {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  channel     ConsentChannel
  granted     Boolean
  /// Verbatim copy of the sentence the person ticked.
  wording     String
  /// Where it happened — the signup page, the settings screen, a WhatsApp keyword.
  sourceUrl   String?
  ip          String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Append-only: withdrawing consent writes a new row with granted=false.
  /// The current state is the newest row per channel. Never an UPDATE.
  @@index([userId, channel, createdAt])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// ONBOARDING TOUR
// ---------------------------------------------------------------------------

enum TourStatus {
  PENDING
  IN_PROGRESS
  SKIPPED
  COMPLETED
}

/// Whether a person has seen a given guided tour.
///
/// Server-side on purpose. localStorage would replay the whole tour every time
/// someone opens a second browser or a new phone, which is exactly the "second
/// login shouldn't show this" case. One row per user, per surface, per tour
/// version.
///
/// The version is part of the key so that a genuinely redesigned portal can
/// re-run its tour deliberately, rather than never again.
model OnboardingState {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  /// A staff member who is also a customer sees the app tour and the admin tour
  /// once each — they are different products to learn.
  surface     Surface
  /// e.g. "app.first-run@2" — slug plus version.
  tourKey     String
  /// Null for admin, where the tour is about the console rather than a workspace.
  workspaceId String?    @db.Uuid
  status      TourStatus @default(PENDING)
  stepIndex   Int        @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, surface, tourKey])
  @@index([userId, surface])
  @@map("onboarding_state")
}

// ---------------------------------------------------------------------------
// AUTH AUDIT
// ---------------------------------------------------------------------------

enum AuthEventType {
  SIGNED_UP
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGGED_OUT
  MFA_CHALLENGED
  MFA_FAILED
  STEP_UP_COMPLETED
  PASSWORD_CHANGED
  MFA_ENROLLED
  MFA_REMOVED
  SESSION_REVOKED
  REFRESH_REUSE_DETECTED
  STAFF_GRANT_ISSUED
  STAFF_GRANT_REVOKED
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED
}

/// Every authentication event, for the customer's own security screen as much
/// as for us. If a customer asks "did someone else sign in?", this answers it.
///
/// REFRESH_REUSE_DETECTED is the row that matters most: it means a refresh
/// token was replayed, which means it was stolen.
model AuthEvent {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String?       @db.Uuid
  type      AuthEventType
  surface   Surface?
  /// Correlates with the request id in the logs, so one string finds both.
  requestId String?
  ip        String?
  userAgent String?
  /// Never credentials, tokens or OTPs. Reason codes and identifiers only.
  detail    Json?
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}

// ---------------------------------------------------------------------------
// RUNTIME CONFIGURATION
//
// These three are read by the application at request time, which is why they
// are rows and not constants: changing a price, a credit cost or which provider
// serves a capability must be an action in the admin console, not a deploy.
// The seed keeps them current in every environment.
// ---------------------------------------------------------------------------

/// What one operation costs a customer, in credits.
model CreditCost {
  code      String   @id  /// e.g. "video.reel"
  credits   Int
  label     String
  updatedAt DateTime @updatedAt

  @@map("credit_costs")
}

/// A subscription tier. Prices are fixed per market and never converted at the
/// day's rate, so a seller budgeting in naira sees the same number every month.
model Plan {
  code          String   @id
  credits       Int
  /// { "USD": 29, "NGN": 39000, "GBP": 24 }
  priceByMarket Json
  /// Effective-dated so historical invoices still reconcile after a price change.
  effectiveFrom DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("plans")
}

/// One value per thing the product can make. Mirrors CAPABILITIES in
/// packages/shared — the API imports both, so drift fails typecheck.
enum ProviderCapability {
  IMAGE_GENERATE
  IMAGE_EDIT
  BACKGROUND_REMOVE
  BACKGROUND_REPLACE
  RELIGHT
  UPSCALE
  IMAGE_TO_VIDEO
  VIDEO_STITCH
  TEXT_GENERATE
  VOICEOVER
  MUSIC
  DUB
  LIPSYNC
}

/// One routable provider model FOR ONE CAPABILITY. The same vendor model can
/// serve several capabilities (an edit model also replaces backgrounds), each
/// as its own row with its own priority, cost and switch — so demoting it for
/// video does not demote it for images. `priority` picks the default and the
/// fallback order; `enabled` is the switch an operator throws during an outage.
model ProviderModel {
  key         String             /// "vertex:gemini-3-pro-image" — what the adapter registry answers to
  capability  ProviderCapability
  priority    Int                @default(10)
  /// Our cost per call in minor units of the billing currency — the input to
  /// the margin figure on the operations dashboard.
  costPerCall Int
  enabled     Boolean            @default(true)
  /// Set by the circuit breaker; cleared automatically or by an operator.
  breakerOpenedAt DateTime?
  /// When set, this row only serves workspaces of this type. An ORGANIZATION
  /// tier can be routed to a provider with licensed training data while the
  /// personal tier uses the cheap one — as a row, not a branch in code.
  workspaceType WorkspaceType?
  /// Vendor-specific settings the adapter reads: model id, endpoint, defaults.
  /// Changing a model version is an edit here, not a deploy.
  config      Json?
  /// The commercial-resale terms this row was approved under, in prose, with
  /// a date. A row with no note has not been checked and must not be enabled
  /// for customer traffic.
  licenceNote String?
  updatedAt   DateTime           @updatedAt

  @@id([key, capability])
  @@index([capability, enabled, priority])
  @@map("provider_models")
}

// ---------------------------------------------------------------------------
// CREDITS — the ledger
//
// There is no balance column anywhere. The balance is the sum of a wallet's
// entries, and `balanceAfter` is denormalised onto each row for cheap reads and
// for detecting drift. Debits and refunds go through Postgres functions that
// lock the wallet row and append inside one transaction — never through
// application code holding two statements. This is the single decision in the
// codebase that cannot be fixed retroactively: you cannot reconstruct a history
// you never wrote.
// ---------------------------------------------------------------------------

/// One wallet per workspace. Holds nothing but identity and currency; the
/// money is in the entries.
model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @unique @db.Uuid
  currency    String   @default("NGN")
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]

  @@map("wallets")
}

enum LedgerKind {
  PURCHASE   // credits bought or granted by a plan renewal
  DEBIT      // spent on a generation
  REFUND     // returned after a failed generation
  PROMO      // free tier, campaigns
  EXPIRY     // plan credits that lapsed
  ADJUSTMENT // staff correction — always with a reason, never an edit
}

/// Append-only. No UPDATE, no DELETE — enforced by a trigger in the migration,
/// so not even a superuser session through the ORM can rewrite history.
model LedgerEntry {
  id             String     @id @default(uuid()) @db.Uuid
  walletId       String     @db.Uuid
  kind           LedgerKind
  /// Signed. Negative for DEBIT and EXPIRY, positive for everything else.
  delta          Int
  /// The wallet balance after this row was applied. Denormalised on purpose.
  balanceAfter   Int
  /// The generation, payment or staff action this row belongs to.
  referenceId    String?    @db.Uuid
  /// Supplied by the caller. Unique per wallet, so a double-tapped button or a
  /// retried webhook short-circuits to the existing row instead of spending twice.
  idempotencyKey String
  reason         String?
  /// Staff user id for ADJUSTMENT rows; null otherwise.
  actorId        String?    @db.Uuid
  createdAt      DateTime   @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([referenceId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// GENERATIONS — the unit of work, and the unit of money
//
// A generation is a ROW BEFORE IT IS A JOB. The row is written and the credits
// are debited in one transaction, before any provider is called; the queue only
// carries the id. That ordering is the whole design, and it is chosen against
// the failure that actually costs money: Redis loses the job, or a worker dies
// mid-call, and a customer has paid for something that never arrives. With the
// row as the source of truth a lost job is a sweep and a retry. With the queue
// as the source of truth it is a support ticket and a manual refund.
//
// Credits are held, not spent: a DEBIT at request time, a REFUND if it ends
// badly. The ledger is append-only, so "giving the credits back" is a new row
// that says so — never an edit, never a deletion. The onboarding tour already
// promises this out loud ("a failed generation gives the credits straight
// back"), which makes it a commitment rather than an intention.
// ---------------------------------------------------------------------------

enum GenerationStatus {
  QUEUED    // row written, credits debited, nothing dispatched yet
  RUNNING   // a worker owns it and has called the provider
  SUCCEEDED // outputs stored; the debit stands
  FAILED    // ended badly; credits refunded
  CANCELLED // withdrawn before a provider was called; credits refunded
}

/// One request for generated media, from click to outputs.
enum GenerationKind {
  STANDALONE // one request, one result
  PARENT     // a plan whose work is done by its children — a 30-second ad
  CHILD      // one shot of a parent; refunded and retried on its own
}

model Generation {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  /// Who asked. Kept even after they leave the workspace — the ledger entry
  /// points at this row, and an audit that cannot name a person is not one.
  requestedById String @db.Uuid

  /// What was asked for. Decides the queue, the router's candidate list and
  /// which pipeline the worker runs.
  capability ProviderCapability
  kind       GenerationKind     @default(STANDALONE)
  /// For CHILD rows: the PARENT whose plan this shot belongs to. A failed shot
  /// refunds and retries itself; the parent only ever waits on its children.
  parentId   String?            @db.Uuid
  /// Supplied by the client and unique per workspace, so a double-tapped
  /// button or a retried request returns the row that already exists instead
  /// of creating — and charging for — a second one. Null only for rows the
  /// system creates for itself (children of a plan).
  clientKey  String?

  /// The CreditCost code this was priced against, e.g. "video.reel".
  costCode String
  /// What it actually cost, captured at request time. Prices are rows and
  /// operators change them; a later change must never rewrite what this
  /// customer was charged.
  credits Int

  status GenerationStatus @default(QUEUED)

  /// The routable model that served it, e.g. "higgsfield:kling3_0". Null until
  /// routed, so a provider outage that prevents routing is still a real row
  /// with a real refund rather than a silent nothing.
  providerKey String?
  /// The provider's own job id. The only way to reconcile a charge on their
  /// invoice with a generation on ours, and what support asks for first.
  providerJobId String?

  /// Inputs and outputs as R2 object keys, never as URLs — URLs expire, are
  /// environment-specific, and would pin us to one storage host forever.
  input   Json
  outputs Json?

  /// Incremented on each dispatch. A generation that has burned its retries
  /// fails for good rather than looping on a provider that will never answer.
  attempts Int @default(0)

  /// Refreshed by the worker while it holds the job. This, not startedAt, is
  /// what the sweeper reads: a legitimate video generation can run for minutes,
  /// and a fixed timeout would either kill honest work or wait forever on a
  /// dead worker.
  heartbeatAt DateTime?

  /// Operator-facing. Never rendered to the customer verbatim — provider
  /// errors leak model names, quotas and sometimes prompt text.
  failureReason String?
  /// Which of the five ProviderError kinds it failed with, when it did. This,
  /// not failureReason, chooses the sentence the customer sees.
  failureKind   String?

  /// The stage the worker last reported and how far along it is, 0–100.
  /// Written so a studio that reconnects after a lost stream — or after Redis
  /// went away — can render the truth from the row alone.
  stage    String?
  progress Int     @default(0)

  /// What the vendor actually charged us for this row, in minor units, when
  /// the adapter knows it. Margin on the operations dashboard is credits sold
  /// minus the sum of this.
  providerCostMinor Int?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User      @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  parent      Generation?  @relation("GenerationChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Generation[] @relation("GenerationChildren")
  assets      MediaAsset[]

  /// One row per client request, per workspace.
  @@unique([workspaceId, clientKey])
  /// The customer's history screen, newest first.
  @@index([workspaceId, createdAt])
  /// The sweeper: everything unfinished, oldest first.
  @@index([status, heartbeatAt])
  /// Provider webhooks and support lookups arrive with this and nothing else.
  @@index([providerJobId])
  /// A parent collecting its shots.
  @@index([parentId])
  @@map("generations")
}

// ---------------------------------------------------------------------------
// MEDIA — what customers upload and what the pipeline produces
//
// The browser uploads straight to storage against a presigned URL; the API
// never proxies bytes. A row is written when the upload is announced and
// promoted to READY only after the API has looked at the object itself —
// its real content type by magic bytes, its size, its dimensions — because a
// file name is a claim, not a fact.
// ---------------------------------------------------------------------------

enum MediaKind {
  SOURCE  // uploaded by a customer
  OUTPUT  // produced by a generation
  DERIVED // thumbnails, proxies, masks — recreatable, expendable
}

enum MediaStatus {
  PENDING  // presigned, not yet seen
  READY    // verified and usable
  REJECTED // wrong type, too large, or failed the content gate
}

model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  workspaceId  String      @db.Uuid
  uploadedById String?     @db.Uuid
  generationId String?     @db.Uuid
  kind         MediaKind
  status       MediaStatus @default(PENDING)
  /// The storage object key. Unique: one object, one row.
  key          String      @unique
  /// Verified from the bytes, never from the upload's declared type.
  mime         String?
  bytes        Int?
  width        Int?
  height       Int?
  durationMs   Int?
  /// SHA-256 of the object, so the same photo uploaded twice can be found.
  sha256       String?
  /// The name the customer gave the file — for the library, never for storage.
  filename     String?
  createdAt    DateTime    @default(now())
  /// Soft delete; the object is removed by a lifecycle job after a grace period.
  deletedAt    DateTime?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, sha256])
  @@index([generationId])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// COPY FINGERPRINTS — no two merchants get the same description
//
// An organisation submitting a catalogue must not receive near-identical
// descriptions for near-identical products: search engines fold duplicate
// text, and a marketplace page that reads like the next one sells neither.
// Each description is fingerprinted (MinHash over word shingles — sixty-four
// small integers) and compared against the workspace's recent ones before it
// is accepted. A near-duplicate is written again with the offending phrasing
// quoted back to the model. No vendor, no embedding service, milliseconds.
// ---------------------------------------------------------------------------

model CopyFingerprint {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  generationId String   @db.Uuid
  /// The seller's own id for the product, when given, so re-running the same product is not a duplicate of itself.
  productKey   String?
  /// Sixty-four MinHash values over word 3-grams of the long description.
  minhash      Int[]
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("copy_fingerprints")
}

// ---------------------------------------------------------------------------
// BRAND KIT — applied to every generation in a workspace
//
// Text, price and the logo are composited by us, deterministically, never
// asked of an image model — a model cannot be trusted to spell a price.
// ---------------------------------------------------------------------------

model BrandKit {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @unique @db.Uuid
  businessName String?
  /// Storage key of the logo, a MediaAsset the customer uploaded.
  logoKey      String?
  /// Up to six hex colours, primary first.
  palette      Json?
  fontDisplay  String?
  fontBody     String?
  /// Free prose the copy pipeline conditions on: "warm, direct, no slang".
  tone         String?
  /// { enabled, position: "br" | "bl" | "tr" | "tl", opacity }
  watermark    Json?
  showPrice    Boolean  @default(true)
  /// Default export sizes, as ExportSize keys from packages/shared.
  defaultSizes Json?
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}
