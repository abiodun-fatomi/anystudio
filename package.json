{
  "name": "anystudio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @anystudio/db run generate",
    "db:migrate": "pnpm --filter @anystudio/db run migrate",
    "db:deploy": "pnpm --filter @anystudio/db run migrate:deploy",
    "db:seed": "pnpm --filter @anystudio/db run seed",
    "db:reset": "pnpm --filter @anystudio/db run reset",
    "infra:up": "docker compose up -d && pnpm db:deploy && pnpm db:seed",
    "infra:down": "docker compose down",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "turbo run lint -- --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "19",
    "@commitlint/config-conventional": "19",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "9",
    "lint-staged": "15",
    "prettier": "3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
