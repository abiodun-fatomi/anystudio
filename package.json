{
  "name": "anystudio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @anystudio/db generate",
    "db:migrate": "pnpm --filter @anystudio/db migrate",
    "db:deploy": "pnpm --filter @anystudio/db deploy",
    "db:seed": "pnpm --filter @anystudio/db seed",
    "db:reset": "pnpm --filter @anystudio/db reset",
    "infra:up": "docker compose up -d && pnpm db:deploy && pnpm db:seed",
    "infra:down": "docker compose down"
  },
  "devDependencies": { "turbo": "^2.1.0", "typescript": "^5.6.0" }
}
