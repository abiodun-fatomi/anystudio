{
  "name": "anystudio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @anystudio/db run generate",
    "db:migrate": "pnpm --filter @anystudio/db run migrate",
    "db:deploy": "pnpm --filter @anystudio/db run migrate:deploy",
    "db:seed": "pnpm --filter @anystudio/db run seed",
    "db:reset": "pnpm --filter @anystudio/db run reset",
    "infra:up": "docker compose up -d && pnpm db:deploy && pnpm db:seed",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0"
  }
}
