# ---- database & queue -------------------------------------------------------
DATABASE_URL="postgresql://anystudio:anystudio@localhost:5432/anystudio?schema=public"
# Migrations only. Once a pgbouncer pool sits in front of the database,
# DATABASE_URL becomes the pooled string and this one stays direct — DDL and
# advisory locks do not survive a transaction pooler. Locally, and on Render
# until you scale past one instance, both are the same server: leave it equal.
DIRECT_URL="postgresql://anystudio:anystudio@localhost:5432/anystudio?schema=public"
# Optional. Without it the API still accepts generations and the worker runs
# them straight from Postgres; with it, jobs and progress events go through
# the queue. Never load-bearing for correctness — see config/redis/index.ts.
REDIS_URL="redis://localhost:6379"

# ---- crypto -----------------------------------------------------------------
# 32 bytes, base64. Encrypts TOTP seeds and provider credentials at rest.
# Rotating this without re-encrypting locks every staff account out of MFA.
APP_KEY="generate-with: openssl rand -base64 32"

# ---- surfaces ---------------------------------------------------------------
# The API derives the surface from the Origin header, matched against this list.
# It is never read from a request body. Staging nests under dev.anystudio.ai so
# no cookie can ever be shared between staging and production.
ORIGIN_APP="http://localhost:3000"
ORIGIN_ORG="http://localhost:3002"
ORIGIN_ADMIN="http://localhost:3003"

# ---- sign in with google -----------------------------------------------------
# One OAuth client, several authorised redirect URIs — one per surface per
# environment, all of the form <app origin>/api/v1/auth/google/callback. The
# callback is on the app's hostname, not the API's, so the handshake cookie
# stays first-party.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- storage ----------------------------------------------------------------
R2_ENDPOINT="http://localhost:9000"
R2_BUCKET="anystudio-dev"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ---- providers (server only — never reachable from the web apps) ------------
# Every one is optional: an adapter registers only when its key is present,
# and a ProviderModel row for a vendor with no key is simply unroutable.
# Outside production the stub adapter serves every capability with no key at
# all. docs/PROVIDERS.md says where each key comes from and what it costs.
FAL_KEY=""                      # fal.ai — Seedream edit, Flux 2, Bria RMBG, Clarity upscale, Wan video
GOOGLE_AI_API_KEY=""            # Gemini Developer API — Gemini 3 Pro Image, Gemini 2.5 Flash-Lite, Veo 3.1
# Vertex AI instead of the developer API (indemnified, GA models): a service
# account JSON as one line, plus project and location. Wins over the key.
GOOGLE_VERTEX_SA_JSON=""
GOOGLE_VERTEX_PROJECT=""
GOOGLE_VERTEX_LOCATION="us-central1"
REPLICATE_API_TOKEN=""          # BiRefNet background removal
PHOTOROOM_API_KEY=""            # background replace, shadows, relight
OPENAI_API_KEY=""               # Sora 2 image-to-video
ANTHROPIC_API_KEY=""            # Claude Haiku 4.5 for brand-voice copy
BFL_API_KEY=""                  # Flux Kontext (budget edit tier)
HIGGSFIELD_API_KEY=""           # Higgsfield platform: key + secret pair; DoP models (rows disabled until resale terms are on file)
HIGGSFIELD_API_SECRET=""
HEYGEN_API_KEY=""               # dubbing/avatars, later phase

# ---- worker -----------------------------------------------------------------
# Jobs per process per weight class. Video holds a slot for minutes.
WORKER_FAST_CONCURRENCY="6"
WORKER_HEAVY_CONCURRENCY="2"
# When Redis is unreachable the worker runs QUEUED rows straight from Postgres,
# this many at a time.
WORKER_DIRECT_CONCURRENCY="2"
# Parents and standalone videos a workspace may request per rolling day. Fails closed.
VIDEO_DAILY_LIMIT="20"

# ---- payments ---------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""

# ---- whatsapp ---------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ---- mail -------------------------------------------------------------------
# Password resets and email verification. Locally this is Mailpit (see
# docker-compose); unset it and the API logs the message instead of sending.
# Resend takes precedence when set; SMTP is the local Mailpit relay; with
# neither, the API logs what it would have sent and still boots.
RESEND_API_KEY=""
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="AnyStudio <no-reply@anystudio.ai>"

# ---- seeding ----------------------------------------------------------------
# "dev" adds demo fixtures. Production refuses this branch outright.
SEED_ENV="dev"
LOG_LEVEL="debug"
