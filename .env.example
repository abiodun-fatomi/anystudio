# ---- database & queue -------------------------------------------------------
DATABASE_URL="postgresql://anystudio:anystudio@localhost:5432/anystudio?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- crypto -----------------------------------------------------------------
# 32 bytes, base64. Encrypts TOTP seeds and provider credentials at rest.
# Rotating this without re-encrypting locks every staff account out of MFA.
APP_KEY="generate-with: openssl rand -base64 32"

# ---- surfaces ---------------------------------------------------------------
# The API derives the surface from the Origin header, matched against this list.
# It is never read from a request body. Staging nests under dev.anystudio.ai so
# no cookie can ever be shared between staging and production.
ORIGIN_APP="http://localhost:3000"
ORIGIN_ORG="http://localhost:3002"
ORIGIN_ADMIN="http://localhost:3003"

# ---- storage ----------------------------------------------------------------
R2_ENDPOINT="http://localhost:9000"
R2_BUCKET="anystudio-dev"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ---- providers (server only — never reachable from the web apps) ------------
HIGGSFIELD_API_KEY=""
HEYGEN_API_KEY=""

# ---- payments ---------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""

# ---- whatsapp ---------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ---- mail -------------------------------------------------------------------
# Password resets and email verification. Locally this is Mailpit (see
# docker-compose); unset it and the API logs the message instead of sending.
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="AnyStudio <no-reply@anystudio.ai>"

# ---- seeding ----------------------------------------------------------------
# "dev" adds demo fixtures. Production refuses this branch outright.
SEED_ENV="dev"
LOG_LEVEL="debug"
