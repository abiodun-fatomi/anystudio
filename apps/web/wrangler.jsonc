/**
 * Cloudflare Workers config for the user portal (app.anystudio.ai).
 *
 * One Worker per environment, each bound to one git branch by Workers
 * Builds, each owning two hostnames: the marketing site and the app
 * (middleware.ts routes by host). The environment name is what
 * `wrangler deploy --env <name>` selects, and it becomes the Worker name
 * suffix in the dashboard: anystudio-app-development, -staging, -production.
 *
 * `custom_domain: true` makes wrangler create the DNS record and the
 * certificate itself — nothing is added by hand in the DNS tab.
 *
 * Only NON-secret, runtime-readable values go in `vars`. There are no
 * build-time values: the app derives its API and admin hostnames from the
 * request host (lib/hosts.ts), so one build deploys to every environment.
 * Deploys run from GitHub Actions (.github/workflows/web-deploy.yml).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anystudio-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // html_handling "none": serve files exactly as named. The default rewrites
  // /org.html to /org at the edge, which fights the host routing in
  // middleware.ts (a rewrite to a .html file would bounce back as a redirect).
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "html_handling": "none" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": false,

  "env": {
    "development": {
      "name": "anystudio-app-development",
      "routes": [
        { "pattern": "app.dev.anystudio.ai", "custom_domain": true },
        { "pattern": "org.dev.anystudio.ai", "custom_domain": true },
        { "pattern": "admin.dev.anystudio.ai", "custom_domain": true },
        { "pattern": "dev.anystudio.ai", "custom_domain": true },
      ],
      "vars": { "NEXTJS_ENV": "development", "APP_ENV": "development" },
    },
    "staging": {
      "name": "anystudio-app-staging",
      "routes": [
        { "pattern": "app.staging.anystudio.ai", "custom_domain": true },
        { "pattern": "org.staging.anystudio.ai", "custom_domain": true },
        { "pattern": "admin.staging.anystudio.ai", "custom_domain": true },
        { "pattern": "staging.anystudio.ai", "custom_domain": true },
      ],
      "vars": { "NEXTJS_ENV": "production", "APP_ENV": "staging" },
    },
    "production": {
      "name": "anystudio-app-production",
      "routes": [
        { "pattern": "app.anystudio.ai", "custom_domain": true },
        { "pattern": "org.anystudio.ai", "custom_domain": true },
        { "pattern": "admin.anystudio.ai", "custom_domain": true },
        { "pattern": "anystudio.ai", "custom_domain": true },
        { "pattern": "www.anystudio.ai", "custom_domain": true },
      ],
      "vars": { "NEXTJS_ENV": "production", "APP_ENV": "production" },
    },
  },
}
