{
  "name": "@anystudio/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:development": "opennextjs-cloudflare build && wrangler deploy --env development",
    "cf:deploy:staging": "opennextjs-cloudflare build && wrangler deploy --env staging",
    "cf:deploy:production": "opennextjs-cloudflare build && wrangler deploy --env production"
  },
  "dependencies": {
    "@anystudio/shared": "workspace:*",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.128.0"
  }
}
